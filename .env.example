# Claude Office 환경 변수 (.env 로 복사해서 쓰세요. .env 는 깃에 올라가지 않아요)
# 모든 값은 이 컴퓨터의 로컬 서버 안에서만 쓰이고, 브라우저나 외부로 보내지지 않아요.

# GitHub 개발본부: 읽기 전용 Fine-grained PAT 권장. 비워두면 로그인된 gh CLI 를 사용해요.
GITHUB_TOKEN=

# 기획팀(Notion): Internal Integration 토큰 (읽기 권한만). 보고 싶은 페이지마다 Integration 을 "연결"해야 보여요.
NOTION_TOKEN=

# 연구팀(Obsidian): 볼트 폴더 경로
OBSIDIAN_VAULT_PATH=~/Documents/MyVault

# 서버 포트 (기본 4747)
PORT=4747

# Claude Code 세션 기록 폴더 (기본 ~/.claude/projects)
# CLAUDE_PROJECTS_DIR=~/.claude/projects
